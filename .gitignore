# FFmpeg
/ffmpeg-*/
/ffmpeg-*.zip

# Pacotes do projeto
/faceless_studio_v*.zip

# Segredos e configurações
.env
**/.env

# Python
.venv/
venv/
__pycache__/
*.pyc

# Arquivos gerados
**/temp/
**/output/
**/assets/generated/
**/assets/media/

# Voz gravada (dado pessoal): gravações e áudios dos canais NÃO vão para o Git.
# Os áudios SINTÉTICOS de teste ficam em pastas "audio_ensaio" e continuam versionáveis.
**/audio/
**/audio_gravado*/
canais/**/*.wav
canais/**/*.mp3
canais/**/*.m4a
canais/**/*.aac
canais/**/*.ogg
canais/**/*.opus
canais/**/*.flac
!canais/**/audio_ensaio/*

# Front-end (a pasta dist/ compilada É versionada: assim não é preciso ter Node para usar)
**/node_modules/

# Cópias de segurança que o Studio cria ao salvar um roteiro
**/*.json.bak

# Sistema
.DS_Store
Thumbs.db
